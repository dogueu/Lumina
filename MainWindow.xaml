<Window x:Class="Lumina.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Lumina"
        Width="320"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        ShowInTaskbar="False"
        ShowActivated="True"
        Topmost="True"
        WindowStartupLocation="Manual"
        KeyDown="OnWindowKeyDown">
    <Window.Resources>
        <!-- WPF-UI'ın Window arka planını ezmesini engelle -->
        <Style TargetType="{x:Type Window}">
            <Setter Property="Background" Value="{x:Static Brushes.Transparent}" />
        </Style>

        <SolidColorBrush x:Key="SystemAccentBrush" Color="#0078D4" />
        <SolidColorBrush x:Key="SliderTrackUnfilledBrush" Color="#8A8A8D" />
        <SolidColorBrush x:Key="SliderThumbCenterBrush" Color="#FFFFFF" />

        <!-- Windows 11 Hızlı Ayarlar Ses/Parlaklık Kaydırıcı Stili -->
        <Style x:Key="Win11SliderStyle" TargetType="{x:Type Slider}">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Height" Value="24" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Slider}">
                        <Grid VerticalAlignment="Center" Height="24">
                            <!-- Tüm uzunluk boyunca uzanan boş çubuk (arkaplan) -->
                            <Border Height="4"
                                    CornerRadius="2"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource SliderTrackUnfilledBrush}" />

                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton OverridesDefaultStyle="True"
                                                  HorizontalAlignment="Stretch"
                                                  VerticalAlignment="Center"
                                                  Focusable="False" IsTabStop="False"
                                                  Command="{x:Static Slider.DecreaseLarge}">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="{x:Type RepeatButton}">
                                                <Border Height="4"
                                                        CornerRadius="2"
                                                        VerticalAlignment="Center"
                                                        Background="{DynamicResource SystemAccentBrush}" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton OverridesDefaultStyle="True"
                                                  HorizontalAlignment="Stretch"
                                                  VerticalAlignment="Center"
                                                  Focusable="False" IsTabStop="False"
                                                  Command="{x:Static Slider.IncreaseLarge}">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="{x:Type RepeatButton}">
                                                <Border Height="4"
                                                        VerticalAlignment="Center"
                                                        Background="Transparent" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb OverridesDefaultStyle="True" Focusable="False" Width="18" Height="18">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Grid Width="18" Height="18" Background="Transparent"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Ellipse x:Name="OuterThumb"
                                                             Width="18" Height="18"
                                                             Fill="{DynamicResource SystemAccentBrush}" />
                                                    <Ellipse x:Name="InnerThumb"
                                                             Width="8" Height="8"
                                                             Fill="{DynamicResource SliderThumbCenterBrush}" />
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="OuterThumb" Property="Width" Value="20" />
                                                        <Setter TargetName="OuterThumb" Property="Height" Value="20" />
                                                        <Setter TargetName="InnerThumb" Property="Width" Value="10" />
                                                        <Setter TargetName="InnerThumb" Property="Height" Value="10" />
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="OuterThumb" Property="Width" Value="18" />
                                                        <Setter TargetName="OuterThumb" Property="Height" Value="18" />
                                                        <Setter TargetName="InnerThumb" Property="Width" Value="6" />
                                                        <Setter TargetName="InnerThumb" Property="Height" Value="6" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="FlyoutCard"
            CornerRadius="8"
            BorderThickness="1"
            SnapsToDevicePixels="True"
            RenderTransformOrigin="0.5,0.5"
            TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
        <Border.RenderTransform>
            <TranslateTransform x:Name="CardTransform" Y="0" />
        </Border.RenderTransform>
        <Grid Margin="16,14,16,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Başlık satırı -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ui:SymbolIcon Grid.Column="0" Symbol="WeatherSunny24" FontSize="18"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="Parlaklık" FontSize="14" FontWeight="SemiBold"
                           FontFamily="Segoe UI Variable Text, Segoe UI"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           Margin="8,0,0,0" VerticalAlignment="Center" />

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <ui:Button x:Name="RefreshButton" Appearance="Transparent" Padding="6"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               ToolTip="Monitörleri yenile" Click="OnRefreshClick">
                        <ui:SymbolIcon Symbol="ArrowSync24" FontSize="15"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    </ui:Button>
                    <ui:Button x:Name="SettingsButton" Appearance="Transparent" Padding="6" Margin="2,0,0,0"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               ToolTip="Ayarlar" Click="OnSettingsClick">
                        <ui:SymbolIcon Symbol="Settings24" FontSize="15"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    </ui:Button>
                </StackPanel>
            </Grid>

            <!-- Dinamik monitör listesi: her DDC/CI monitörü için bir kaydırıcı -->
            <StackPanel Grid.Row="1">
                <ItemsControl x:Name="MonitorList" ItemsSource="{Binding Monitors}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,8"
                                  Background="Transparent"
                                  PreviewMouseWheel="OnSliderMouseWheel">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Name}"
                                           FontFamily="Segoe UI Variable Text, Segoe UI"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           FontSize="12" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Row="0" Grid.Column="1" FontSize="12" FontWeight="SemiBold"
                                           FontFamily="Segoe UI Variable Text, Segoe UI"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                           Text="{Binding Percent, StringFormat={}{0}%}" />

                                <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <ui:SymbolIcon Grid.Column="0" Symbol="WeatherSunny24" FontSize="16"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <Slider Grid.Column="1"
                                            Style="{StaticResource Win11SliderStyle}"
                                            Minimum="0" Maximum="100"
                                            TickFrequency="1" IsSnapToTickEnabled="True"
                                            SmallChange="1" LargeChange="5"
                                            IsMoveToPointEnabled="True"
                                            Value="{Binding Percent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            ValueChanged="OnSliderValueChanged"
                                            PreviewMouseWheel="OnSliderMouseWheel" />
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock x:Name="EmptyText" TextWrapping="Wrap" FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Visibility="Collapsed" Margin="0,0,0,2" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
