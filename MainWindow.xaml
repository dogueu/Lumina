<Window x:Class="Lumina.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:Lumina.Services"
        Title="Lumina"
        Width="380"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="True"
        WindowStartupLocation="Manual"
        Background="Transparent"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="14"
        TextOptions.TextFormattingMode="Display"
        Foreground="{DynamicResource Text.Primary}"
        KeyDown="OnWindowKeyDown">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Vis" />

        <!-- 20x20 silüet ikon stili -->
        <Style x:Key="Glyph" TargetType="Path">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="StrokeThickness" Value="0" />
            <Setter Property="Fill" Value="{Binding Stroke, RelativeSource={RelativeSource Self}}" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Setter Property="Stroke" Value="{DynamicResource Text.Primary}" />
        </Style>

        <!-- Üst bar 32x32 ikon butonu -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                svc:Motion.Hover="{DynamicResource Card.FillHover}"
                                svc:Motion.Press="0.97"
                                CornerRadius="4"
                                Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- İnce kaydırma çubuğu -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="10" />
            <Setter Property="MinWidth" Value="10" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Grid Background="Transparent">
                                                <Border x:Name="Bar" Width="4" CornerRadius="2" Margin="0,4"
                                                        HorizontalAlignment="Center"
                                                        Background="{DynamicResource Text.Tertiary}" Opacity="0.45" />
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bar" Property="Width" Value="6" />
                                                    <Setter TargetName="Bar" Property="CornerRadius" Value="3" />
                                                    <Setter TargetName="Bar" Property="Opacity" Value="0.75" />
                                                </Trigger>
                                                <Trigger Property="IsDragging" Value="True">
                                                    <Setter TargetName="Bar" Property="Width" Value="6" />
                                                    <Setter TargetName="Bar" Property="Opacity" Value="0.9" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" svc:Motion.Press="0.97" CornerRadius="4" Height="32" Padding="16,0"
                                Background="{DynamicResource Accent}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.9" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OutlineButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                svc:Motion.Hover="{DynamicResource Card.FillHover}"
                                svc:Motion.Press="0.97"
                                CornerRadius="4"
                                Padding="12,0"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource Level.Track}"
                                Background="{DynamicResource Button.Fill}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource Text.Tertiary}" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="LineHeight" Value="16" />
            <Setter Property="Foreground" Value="{DynamicResource Text.Tertiary}" />
        </Style>

        <!-- 40x20 kayan anahtar -->
        <Style x:Key="Switch" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="svc:Motion.Switch" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Track" Width="40" Height="20" CornerRadius="10" BorderThickness="1"
                                Background="Transparent" BorderBrush="{DynamicResource Text.Secondary}">
                            <Ellipse x:Name="Knob" Width="12" Height="12" Margin="3,0" HorizontalAlignment="Left"
                                     Fill="{DynamicResource Text.Secondary}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource Accent}" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource Accent.Foreground}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Segment seçici -->
        <Style x:Key="Segment" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg" CornerRadius="4" Padding="{TemplateBinding Padding}" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Segment.Selected}" />
                                <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SegmentTrack" TargetType="Border">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="2" />
            <Setter Property="Background" Value="{DynamicResource Level.Track}" />
        </Style>

        <Style x:Key="Group" TargetType="Border">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{DynamicResource Card.Fill}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Card.Stroke}" />
        </Style>

        <Style x:Key="GroupLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="8,0,0,6" />
            <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
        </Style>

        <Style x:Key="Rule" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="{DynamicResource Divider}" />
        </Style>

        <!-- Slider tutamacı -->
        <Style x:Key="SliderThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Grid Width="20" Height="20" Background="Transparent">
                            <Ellipse x:Name="OuterThumb" Width="18" Height="18" Fill="{DynamicResource Slider.ThumbOuter}">
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="3" ShadowDepth="1" Opacity="0.25" />
                                </Ellipse.Effect>
                            </Ellipse>
                            <Ellipse x:Name="InnerThumb" Width="8" Height="8" Fill="{DynamicResource Slider.ThumbInner}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="OuterThumb" Property="Width" Value="20" />
                                <Setter TargetName="OuterThumb" Property="Height" Value="20" />
                                <Setter TargetName="InnerThumb" Property="Width" Value="10" />
                                <Setter TargetName="InnerThumb" Property="Height" Value="10" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="OuterThumb" Property="Width" Value="18" />
                                <Setter TargetName="OuterThumb" Property="Height" Value="18" />
                                <Setter TargetName="InnerThumb" Property="Width" Value="6" />
                                <Setter TargetName="InnerThumb" Property="Height" Value="6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Ayarlar içi AccentSlider -->
        <Style x:Key="AccentSlider" TargetType="Slider">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="20" Background="Transparent">
                            <Border Height="4" CornerRadius="2" Background="{DynamicResource Level.Track}" VerticalAlignment="Center" />
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" CornerRadius="2" Background="{DynamicResource Accent}" VerticalAlignment="Center" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource SliderThumb}" />
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Monitör kartları için parlaklık kaydırıcısı -->
        <Style x:Key="EmberSlider" TargetType="Slider">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="20" Background="Transparent">
                            <Border Height="4" CornerRadius="2" Background="{DynamicResource Slider.Track}" VerticalAlignment="Center" />
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" CornerRadius="2" Background="{DynamicResource Slider.Fill}" VerticalAlignment="Center">
                                                    <Border.Effect>
                                                        <DropShadowEffect ShadowDepth="0" BlurRadius="6"
                                                                          Color="{DynamicResource Ember.Color}"
                                                                          Opacity="{DynamicResource Ember.GlowOpacity}" />
                                                    </Border.Effect>
                                                </Border>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource SliderThumb}" />
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Temalı metin kutusu (özel isim ve kısayol girişi için) -->
        <Style x:Key="LuminaTextBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
            <Setter Property="CaretBrush" Value="{DynamicResource Accent}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource Accent}" />
            <Setter Property="Background" Value="{DynamicResource Button.Fill}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Level.Track}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                CornerRadius="4"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <TextBlock x:Name="PlaceholderText"
                                           Text="{Binding (svc:Motion.Placeholder), RelativeSource={RelativeSource TemplatedParent}}"
                                           Foreground="{DynamicResource Text.Tertiary}"
                                           FontSize="{TemplateBinding FontSize}"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"
                                           Visibility="Collapsed"
                                           TextTrimming="CharacterEllipsis" />
                                <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="PlaceholderText" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="Text" Value="{x:Null}">
                                <Setter TargetName="PlaceholderText" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Card.FillHover}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Ana liste monitör kartı şablonu -->
        <DataTemplate x:Key="MonitorCardTemplate">
            <Border svc:Motion.Hover="{DynamicResource Card.FillHover}"
                    Margin="0,0,0,4"
                    Padding="12,10,12,10"
                    CornerRadius="6"
                    BorderThickness="1"
                    Background="{DynamicResource Card.Fill}"
                    BorderBrush="{DynamicResource Card.Stroke}"
                    PreviewMouseWheel="OnSliderMouseWheel">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Monitör ikon kutusu -->
                    <Border Grid.Row="0" Grid.Column="0" Width="32" Height="32" CornerRadius="6"
                            Background="{DynamicResource Tile.Fill}" VerticalAlignment="Center">
                        <Viewbox Width="18" Height="18">
                            <Path Style="{StaticResource Glyph}" Data="{x:Static svc:Icons.Monitor}"
                                  Stroke="{DynamicResource Text.Secondary}" />
                        </Viewbox>
                    </Border>

                    <!-- Monitör adı ve kısayol durumu -->
                    <StackPanel Grid.Row="0" Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" LineHeight="20" />
                        <WrapPanel Margin="0,2,0,0" Opacity="0.72">
                            <TextBlock Style="{StaticResource Caption}" FontSize="11" Text="DDC/CI" Margin="0,0,8,0" />
                            <StackPanel Orientation="Horizontal" Visibility="{Binding IsHotkeyEnabled, Converter={StaticResource Vis}}">
                                <Ellipse Width="5" Height="5" Fill="{DynamicResource Ember}" Margin="0,1,5,0" VerticalAlignment="Center">
                                    <Ellipse.Effect>
                                        <DropShadowEffect ShadowDepth="0" BlurRadius="6"
                                                          Color="{DynamicResource Ember.Color}"
                                                          Opacity="{DynamicResource Ember.GlowOpacity}" />
                                    </Ellipse.Effect>
                                </Ellipse>
                                <TextBlock Style="{StaticResource Caption}" FontSize="11" Foreground="{DynamicResource Text.Tertiary}"
                                           Text="{Binding HotkeyStatusText}" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource Caption}" FontSize="11" Text="{Binding HotkeyStatusText}"
                                       Visibility="{Binding IsHotkeyDisabled, Converter={StaticResource Vis}}" />
                        </WrapPanel>
                    </StackPanel>

                    <!-- Sağdaki büyük Tabular değer -->
                    <TextBlock Grid.Row="0" Grid.Column="3"
                               Text="{Binding Percent}"
                               FontFamily="Segoe UI Variable Display, Segoe UI"
                               FontSize="20" FontWeight="SemiBold"
                               Typography.NumeralAlignment="Tabular"
                               Foreground="{DynamicResource Text.Primary}"
                               VerticalAlignment="Center"
                               Margin="12,0,0,0" />

                    <!-- Etkileşimli Ember parlaklık kaydırıcısı -->
                    <Slider Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2"
                            Margin="0,8,0,0"
                            Style="{StaticResource EmberSlider}"
                            Minimum="0" Maximum="100"
                            TickFrequency="1" IsSnapToTickEnabled="True"
                            SmallChange="1" LargeChange="5"
                            Value="{Binding Percent, Mode=OneWay}"
                            ValueChanged="OnSliderValueChanged"
                            PreviewMouseWheel="OnSliderMouseWheel" />
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Border x:Name="Root"
            CornerRadius="8"
            BorderThickness="1"
            BorderBrush="{DynamicResource Window.Stroke}"
            Background="{DynamicResource Window.Tint}">
        <Grid x:Name="Body">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="Slide" />
            </Grid.RenderTransform>

            <!-- ============ Ana Görünüm ============ -->
            <DockPanel x:Name="MainView">
                <!-- Üst Başlık -->
                <Grid DockPanel.Dock="Top" Margin="16,12,12,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock FontFamily="pack://application:,,,/Fonts/#Geist" FontSize="15" FontWeight="SemiBold" LineHeight="20">
                            <Run Text="Lumina" /><InlineUIContainer BaselineAlignment="Baseline">
                                <Ellipse Width="2.6" Height="2.6" Margin="0.6,0,0,0.4" Fill="{DynamicResource Brand.Dot}" />
                            </InlineUIContainer>
                        </TextBlock>
                        <TextBlock x:Name="SubtitleText" Style="{StaticResource Caption}" Visibility="Collapsed" />
                    </StackPanel>

                    <Border x:Name="ReadingPill" Grid.Column="1" Height="32" Padding="12,0" CornerRadius="4" Margin="0,0,4,0"
                            Background="{DynamicResource Button.Fill}" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Viewbox Width="16" Height="16" Margin="0,0,6,0" RenderTransformOrigin="0.5,0.5">
                                <Viewbox.RenderTransform>
                                    <RotateTransform x:Name="Spin" />
                                </Viewbox.RenderTransform>
                                <Path Style="{StaticResource Glyph}" Data="{x:Static svc:Icons.Spinner}" Stroke="{DynamicResource Accent}" />
                            </Viewbox>
                            <TextBlock Text="Taranıyor…" FontSize="12" Foreground="{DynamicResource Text.Secondary}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <Button x:Name="RefreshButton" Grid.Column="1" Style="{StaticResource IconButton}"
                            ToolTip="Monitörleri yenile" Margin="0,0,4,0" Click="OnRefreshClick">
                        <Viewbox Width="16" Height="16">
                            <Path Style="{StaticResource Glyph}" Data="{x:Static svc:Icons.Refresh}" />
                        </Viewbox>
                    </Button>

                    <Button x:Name="SettingsButton" Grid.Column="2" Style="{StaticResource IconButton}"
                            ToolTip="Ayarlar" Click="OnSettingsClick">
                        <Viewbox Width="16" Height="16">
                            <Path Style="{StaticResource Glyph}" Data="{x:Static svc:Icons.Sliders}" />
                        </Viewbox>
                    </Button>
                </Grid>

                <!-- Alt Bilgi -->
                <Border DockPanel.Dock="Bottom" Margin="0,8,0,0" BorderThickness="0,1,0,0"
                        BorderBrush="{DynamicResource Divider}" Padding="16,10,16,12">
                    <DockPanel>
                        <StackPanel x:Name="LiveLegend" DockPanel.Dock="Right" Orientation="Horizontal" Visibility="Collapsed">
                            <Ellipse Width="6" Height="6" Fill="{DynamicResource Accent}" Margin="0,1,5,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="LiveLegendText" Style="{StaticResource Caption}" />
                        </StackPanel>
                        <TextBlock x:Name="FooterText" Style="{StaticResource Caption}" />
                    </DockPanel>
                </Border>

                <!-- İçerik -->
                <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <StackPanel x:Name="EmptyView" Margin="32,20" HorizontalAlignment="Center" Visibility="Collapsed">
                            <Border Width="48" Height="48" CornerRadius="10" Background="{DynamicResource Tile.Fill}" Margin="0,0,0,12">
                                <Viewbox Width="24" Height="24">
                                    <Path Style="{StaticResource Glyph}" Data="{x:Static svc:Icons.Monitor}" Stroke="{DynamicResource Text.Secondary}" />
                                </Viewbox>
                            </Border>
                            <TextBlock Text="Monitör bulunamadı" FontSize="16" FontWeight="SemiBold" TextAlignment="Center" />
                            <TextBlock x:Name="EmptyBody" FontSize="13" LineHeight="18" Margin="0,6,0,0"
                                       TextAlignment="Center" TextWrapping="Wrap"
                                       Foreground="{DynamicResource Text.Secondary}" />
                            <Button x:Name="EmptyRefresh" Style="{StaticResource AccentButton}" HorizontalAlignment="Center"
                                    Margin="0,16,0,0" Click="OnRefreshClick">
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="14" Height="14" Margin="0,0,6,0">
                                        <Path Style="{StaticResource Glyph}" Data="{x:Static svc:Icons.Refresh}" Stroke="{DynamicResource Accent.Foreground}" />
                                    </Viewbox>
                                    <TextBlock Text="Yenile" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Accent.Foreground}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <ItemsControl x:Name="MonitorList" Margin="8,0"
                                      ItemsSource="{Binding Monitors}"
                                      ItemTemplate="{StaticResource MonitorCardTemplate}" />
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>

            <!-- ============ Ayarlar Görünümü ============ -->
            <DockPanel x:Name="SettingsView" Visibility="Collapsed">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,12,12,12">
                    <Button x:Name="BackButton" Style="{StaticResource IconButton}" ToolTip="Geri">
                        <Viewbox Width="16" Height="16">
                            <Path Style="{StaticResource Glyph}" Data="{x:Static svc:Icons.Back}" />
                        </Viewbox>
                    </Button>
                    <TextBlock Text="Ayarlar" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,0,0" />
                </StackPanel>

                <Border DockPanel.Dock="Bottom" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Divider}" Padding="16,10,16,12">
                    <DockPanel>
                        <Button x:Name="ResetButton" DockPanel.Dock="Right" Style="{StaticResource OutlineButton}" Content="Varsayılanlara sıfırla" />
                        <TextBlock x:Name="VersionText" Style="{StaticResource Caption}" VerticalAlignment="Center" Text="Lumina" />
                    </DockPanel>
                </Border>

                <ScrollViewer x:Name="SettingsScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="8,0,8,8">
                        <!-- Görünüm -->
                        <TextBlock Style="{StaticResource GroupLabel}" Text="Görünüm" />
                        <Border Style="{StaticResource Group}" Padding="14,12">
                            <StackPanel>
                                <Border Style="{StaticResource SegmentTrack}">
                                    <UniformGrid Columns="3">
                                        <RadioButton x:Name="AppearanceGlass" GroupName="Appearance" Style="{StaticResource Segment}" Padding="4,6" Content="Renkli cam" />
                                        <RadioButton x:Name="AppearanceSystem" GroupName="Appearance" Style="{StaticResource Segment}" Padding="4,6" Content="Sistem" />
                                        <RadioButton x:Name="AppearanceSolid" GroupName="Appearance" Style="{StaticResource Segment}" Padding="4,6" Content="Katı" />
                                    </UniformGrid>
                                </Border>

                                <StackPanel x:Name="BlurBlock" Margin="0,12,0,0">
                                    <DockPanel>
                                        <ToggleButton x:Name="BlurSwitch" DockPanel.Dock="Right" Style="{StaticResource Switch}" Margin="10,0,0,0" />
                                        <StackPanel>
                                            <TextBlock x:Name="BlurTitle" Text="Arka planı bulanıklaştır" />
                                            <TextBlock x:Name="BlurCaption" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DockPanel>
                                    <Button x:Name="ColorsButton" Style="{StaticResource OutlineButton}" HorizontalAlignment="Left" Margin="0,10,0,0">
                                        <TextBlock Text="Windows renk ayarlarını aç" />
                                    </Button>
                                </StackPanel>

                                <StackPanel x:Name="OpacityBlock" Margin="0,12,0,0">
                                    <DockPanel>
                                        <TextBlock x:Name="OpacityValue" DockPanel.Dock="Right" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" />
                                        <TextBlock Text="Cam opaklığı" />
                                    </DockPanel>
                                    <Slider x:Name="OpacitySlider" Style="{StaticResource AccentSlider}" Margin="0,8,0,0"
                                            Minimum="20" Maximum="95" SmallChange="1" LargeChange="5" IsSnapToTickEnabled="True" TickFrequency="1" />
                                </StackPanel>

                                <TextBlock x:Name="AppearanceNote" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,10,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Monitörler -->
                        <TextBlock Style="{StaticResource GroupLabel}" Text="Monitörler" Margin="8,16,0,6" />
                        <Border Style="{StaticResource Group}">
                            <StackPanel>
                                <StackPanel x:Name="SettingsMonitorsPanel" />
                                <TextBlock x:Name="SettingsNoMonitorsText"
                                           Style="{StaticResource Caption}"
                                           Margin="14,12"
                                           Text="Şu anda algılanmış DDC/CI monitör bulunmuyor."
                                           Visibility="Collapsed" />
                            </StackPanel>
                        </Border>

                        <!-- Parlaklık ve kısayollar -->
                        <TextBlock Style="{StaticResource GroupLabel}" Text="Parlaklık ve kısayollar" Margin="8,16,0,6" />
                        <Border Style="{StaticResource Group}">
                            <StackPanel>
                                <StackPanel Margin="14,12,14,14">
                                    <DockPanel>
                                        <TextBlock x:Name="StepValue" DockPanel.Dock="Right" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" VerticalAlignment="Center" />
                                        <StackPanel>
                                            <TextBlock Text="Değişim adımı" />
                                            <TextBlock Style="{StaticResource Caption}" Text="Kısayol ve tepsi tekerleği adımı" />
                                        </StackPanel>
                                    </DockPanel>
                                    <Slider x:Name="StepSlider" Style="{StaticResource AccentSlider}" Margin="0,10,0,0"
                                            Minimum="1" Maximum="50" SmallChange="1" LargeChange="5" IsSnapToTickEnabled="True" TickFrequency="1" />
                                </StackPanel>
                                <Border Style="{StaticResource Rule}" />

                                <DockPanel Margin="14,10">
                                    <TextBox x:Name="IncreaseBox" DockPanel.Dock="Right" Width="148" IsReadOnly="True"
                                             Tag="Increase" Style="{StaticResource LuminaTextBox}"
                                             svc:Motion.Placeholder="Kısayola basın"
                                             PreviewKeyDown="OnHotkeyKeyDown" />
                                    <TextBlock Text="Parlaklığı artır" VerticalAlignment="Center" Margin="0,0,10,0" />
                                </DockPanel>
                                <Border Style="{StaticResource Rule}" />

                                <DockPanel Margin="14,10">
                                    <TextBox x:Name="DecreaseBox" DockPanel.Dock="Right" Width="148" IsReadOnly="True"
                                             Tag="Decrease" Style="{StaticResource LuminaTextBox}"
                                             svc:Motion.Placeholder="Kısayola basın"
                                             PreviewKeyDown="OnHotkeyKeyDown" />
                                    <TextBlock Text="Parlaklığı azalt" VerticalAlignment="Center" Margin="0,0,10,0" />
                                </DockPanel>

                                <TextBlock x:Name="HotkeyErrorText"
                                           Margin="14,0,14,10"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource Level.Alert}"
                                           Visibility="Collapsed" />
                            </StackPanel>
                        </Border>

                        <!-- Genel -->
                        <TextBlock Style="{StaticResource GroupLabel}" Text="Genel" Margin="8,16,0,6" />
                        <Border Style="{StaticResource Group}">
                            <StackPanel>
                                <DockPanel Margin="14,12">
                                    <ToggleButton x:Name="StartupSwitch" DockPanel.Dock="Right" Style="{StaticResource Switch}" Margin="10,0,0,0" />
                                    <StackPanel>
                                        <TextBlock Text="Windows ile başlat" />
                                        <TextBlock Style="{StaticResource Caption}" Text="Oturum açıldığında tepsiye yerleşir" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DockPanel>
                                <Border Style="{StaticResource Rule}" />
                                <DockPanel Margin="14,12">
                                    <ToggleButton x:Name="OsdSwitch" DockPanel.Dock="Right" Style="{StaticResource Switch}" Margin="10,0,0,0" />
                                    <StackPanel>
                                        <TextBlock Text="Ekran göstergesi (OSD)" />
                                        <TextBlock Style="{StaticResource Caption}" Text="Kısayol ve tepsi tekerleğinde seviyeyi göster" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DockPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Grid>
    </Border>
</Window>
