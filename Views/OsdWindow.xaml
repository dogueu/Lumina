<Window x:Class="Lumina.Views.OsdWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:Lumina.Services"
        Title="Lumina OSD"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Focusable="False"
        IsHitTestVisible="False"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        TextOptions.TextFormattingMode="Display">
    <Border x:Name="Card"
            Width="192"
            Height="46"
            Padding="14,0,14,0"
            CornerRadius="8"
            BorderThickness="1"
            Background="{DynamicResource Osd.Tint}"
            BorderBrush="{DynamicResource Osd.Stroke}"
            SnapsToDevicePixels="True">
        <Grid x:Name="CardBody" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="BodyTransform" Y="0" />
            </Grid.RenderTransform>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Güneş ikonu -->
            <Viewbox Grid.Column="0" Width="16" Height="16" Margin="0,0,10,0" VerticalAlignment="Center">
                <Path Width="20" Height="20"
                      Data="{x:Static svc:Icons.Sun}"
                      Fill="{DynamicResource Osd.IconBrush}" />
            </Viewbox>

            <!-- Parlaklık çubuğu -->
            <Border Grid.Column="1" Margin="0" Height="4" CornerRadius="2"
                    Background="{DynamicResource Osd.Track}"
                    VerticalAlignment="Center">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="FillCol" Width="0*" />
                        <ColumnDefinition x:Name="RestCol" Width="100*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" CornerRadius="2" Background="{DynamicResource Slider.Fill}">
                        <Border.Effect>
                            <DropShadowEffect ShadowDepth="0" BlurRadius="6"
                                              Color="{DynamicResource Ember.Color}"
                                              Opacity="{DynamicResource Ember.GlowOpacity}" />
                        </Border.Effect>
                    </Border>
                </Grid>
            </Border>

            <!-- Tabular değer -->
            <TextBlock x:Name="PercentText"
                       Grid.Column="2"
                       Width="24"
                       TextAlignment="Right"
                       FontFamily="Segoe UI Variable Text, Segoe UI"
                       FontSize="14" FontWeight="Normal"
                       Typography.NumeralAlignment="Tabular"
                       Foreground="{DynamicResource Text.Primary}"
                       Margin="6,-1,0,0"
                       VerticalAlignment="Center" />
        </Grid>
    </Border>
</Window>
